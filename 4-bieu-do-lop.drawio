        <mxCell id="c5" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Song&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;- id: int&lt;br&gt;- title: String&lt;br&gt;- artist: String&lt;br&gt;- genreId: int?&lt;br&gt;- genreName: String?&lt;br&gt;- durationSeconds: int&lt;br&gt;- coverUrl: String?&lt;br&gt;- audioUrl: String?&lt;br&gt;- lyrics: String?&lt;br&gt;- playCount: int&lt;br&gt;- isVisible: bool&lt;br&gt;- createdAt: DateTime?&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;+ durationLabel: String «get»&lt;br&gt;+ parseDuration(input: String): int? «static»&lt;br&gt;+ fromJson(json: Map): Song «factory»&lt;br&gt;+ toJson(): Map&lt;br&gt;+ copyWith(…): Song&lt;/p&gt;" vertex="1">
