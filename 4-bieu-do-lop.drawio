        <mxCell id="c6" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Playlist&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;- id: int&lt;br&gt;- name: String&lt;br&gt;- description: String?&lt;br&gt;- coverUrl: String?&lt;br&gt;- isVisible: bool&lt;br&gt;- songCount: int&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;+ fromJson(json: Map): Playlist «factory»&lt;br&gt;+ toJson(): Map&lt;br&gt;+ copyWith(…): Playlist&lt;/p&gt;" vertex="1">
