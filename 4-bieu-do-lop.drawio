        <mxCell id="c2" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;i&gt;«enumeration»&lt;/i&gt;&lt;br&gt;&lt;b&gt;UserRole&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;user&lt;br&gt;admin&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;+ fromString(value: String?): UserRole «static»&lt;/p&gt;" vertex="1">
          <mxGeometry height="127" width="270" x="20" y="60" as="geometry" />
        </mxCell>
        <mxCell id="c3" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;AppUser&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;- id: String&lt;br&gt;- name: String&lt;br&gt;- email: String&lt;br&gt;- role: UserRole&lt;br&gt;- isActive: bool&lt;br&gt;- avatarUrl: String?&lt;br&gt;- createdAt: DateTime?&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;+ isAdmin: bool «get»&lt;br&gt;+ initial: String «get»&lt;br&gt;+ fromJson(json: Map): AppUser «factory»&lt;br&gt;+ toJson(): Map&lt;br&gt;+ copyWith(…): AppUser&lt;/p&gt;" vertex="1">
          <mxGeometry height="247" width="270" x="360" y="50" as="geometry" />
        </mxCell>
        <mxCell id="c4" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Genre&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;- id: int&lt;br&gt;- name: String&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;+ fromJson(json: Map): Genre «factory»&lt;br&gt;+ toJson(): Map&lt;/p&gt;" vertex="1">
